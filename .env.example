# Copy to .env (repo root or backend/). Every value here has a working dev default.
APP_ENV=development

# SQLite for local dev; PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://aquarium:password@localhost:5432/aquarium
DATABASE_URL=sqlite:///./aquarium.db

# true = the "Generate readings" button and POST /simulate/run are allowed.
# Set false once real sensors are connected.
SIMULATION_MODE=true
# Farm local time vs UTC; puts the simulated dawn oxygen low at local dawn.
FARM_UTC_OFFSET_HOURS=5.5

# Change before any shared deployment.
DEVICE_API_KEY=dev-device-key-change-me
# Operators log in with the seeded "operator" account; password via OPERATOR_PASSWORD.
OPERATOR_PASSWORD=letmein
# Signs the operator session cookies.
SECRET_KEY=dev-secret-change-me

# Comma-separated list of dashboard origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MQTT broker login (docker compose): ESP32 gateways and the bridge use it. Change before deployment.
MQTT_USER=fishut
MQTT_PASSWORD=dev-mqtt-change-me
